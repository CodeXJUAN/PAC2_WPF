<UserControl
    x:Class="WPF_MVVM_SPA_Template.Views.FormulariView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:CustomControlsLib;assembly=CustomControlsLib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_MVVM_SPA_Template.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.8*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ID  -->
        <TextBlock
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="ID:" />
        <TextBlock
            Name="txtID"
            Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            VerticalAlignment="Center"
            Text="{Binding Client.Id}">
            <TextBlock.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Identificador únic del client (generat automàticament)
                </ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <!--  DNI  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="DNI:" />
        <custom:DNITextBox
            Grid.Row="1"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            DNIValue="{Binding Client.DNI, UpdateSourceTrigger=PropertyChanged}">
            <custom:DNITextBox.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Introdueix un DNI vàlid (8 números i 1 lletra)
                </ToolTip>
            </custom:DNITextBox.ToolTip>
        </custom:DNITextBox>
        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding DNIError}"
            TextWrapping="Wrap" />

        <!--  Nom  -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Nom:" />
        <custom:MinLengthTextBox
            Grid.Row="3"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            MinLength="3"
            Text="{Binding Client.Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <custom:MinLengthTextBox.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Introdueix el nom del client (mínim 3 caràcters)
                </ToolTip>
            </custom:MinLengthTextBox.ToolTip>
        </custom:MinLengthTextBox>
        <TextBlock
            Grid.Row="4"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding NomError}"
            TextWrapping="Wrap" />

        <!--  Cognoms  -->
        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Height="20"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Cognoms:" />
        <custom:MinLengthTextBox
            Grid.Row="5"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            MinLength="5"
            Text="{Binding Client.Cognoms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <custom:MinLengthTextBox.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Introdueix els cognoms del client (mínim 5 caràcters)
                </ToolTip>
            </custom:MinLengthTextBox.ToolTip>
        </custom:MinLengthTextBox>
        <TextBlock
            Grid.Row="6"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding CognomsError}"
            TextWrapping="Wrap" />

        <!--  Email  -->
        <TextBlock
            Grid.Row="7"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Email:" />
        <custom:EmailTextBox
            Grid.Row="7"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            Email="{Binding Client.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <custom:EmailTextBox.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Introdueix una adreça de correu electrònic vàlida (exemple: nom@domini.com)
                </ToolTip>
            </custom:EmailTextBox.ToolTip>
        </custom:EmailTextBox>
        <TextBlock
            Grid.Row="8"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding EmailError}"
            TextWrapping="Wrap" />

        <!--  Telèfon  -->
        <TextBlock
            Grid.Row="9"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Telèfon:" />
        <TextBox
            Name="txtTelefono"
            Grid.Row="9"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            Text="{Binding Client.Telefon, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
            <TextBox.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Introdueix un número de telèfon vàlid, incloent el prefix si és necessari
                </ToolTip>
            </TextBox.ToolTip>
        </TextBox>
        <TextBlock
            Grid.Row="10"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding TelefonError}"
            TextWrapping="Wrap" />

        <!--  Data Alta  -->
        <TextBlock
            Grid.Row="11"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#2C3E50"
            Text="Data Alta:" />
        <DatePicker
            Name="dpFechaAlta"
            Grid.Row="11"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Center"
            Text="{Binding Client.DataAlta, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
            <DatePicker.ToolTip>
                <ToolTip
                    Background="#2C3E50"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Foreground="White">
                    Selecciona la data d'alta del client (ha de ser igual o posterior a avui)
                </ToolTip>
            </DatePicker.ToolTip>
        </DatePicker>
        <TextBlock
            Grid.Row="12"
            Grid.Column="1"
            Margin="10,0,10,10"
            Foreground="Red"
            Text="{Binding DataAltaError}"
            TextWrapping="Wrap" />

        <!--  Botons  -->
        <StackPanel
            Grid.Row="12"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="0,5,33,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Button
                Width="99"
                Height="40"
                Margin="5"
                Background="#2C3E50"
                Command="{Binding GuardarCommand}"
                Content="Guardar"
                Foreground="White" />
            <Button
                Width="99"
                Height="40"
                Margin="5"
                Background="DarkRed"
                Command="{Binding CancelarCommand}"
                Content="Cancel·lar"
                Foreground="White" />
        </StackPanel>
    </Grid>
</UserControl>
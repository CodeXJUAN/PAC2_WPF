<UserControl x:Class="CustomControlsLib.DNITextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControlsLib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBox x:Name="txtDNI" 
             Text="{Binding DNIValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" 
             MaxLength="9"
             BorderBrush="{Binding BorderColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
             BorderThickness="1"
             Padding="2"
             VerticalContentAlignment="Center"/>
    </Grid>
</UserControl>

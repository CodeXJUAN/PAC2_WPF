<Window
       x:Class="WpfApp1.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="MainWindow"
       Width="800"
       Height="450">
    <Grid Margin="20">
        <Border
            BorderBrush="Blue"
            BorderThickness="2"
            CornerRadius="5">
            <TextBox
                x:Name="emailTextBox"
                Padding="5"
                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
    </Grid>
</Window>